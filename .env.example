# Copy to .env.local for local development.
# In production these are set in Vercel → Settings → Environment Variables.

# Postgres — injected automatically when you connect a Vercel Postgres (Neon)
# database to the project. For local dev, copy the values from
# Vercel Dashboard → Storage → your DB → the ".env.local" tab.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# Required — password for the /admin dashboard (simple cookie auth, no
# external auth service).
ADMIN_PASSWORD=

# Optional — enables headshot uploads via Vercel Blob. Without it the
# submission form still works; headshots are just skipped.
BLOB_READ_WRITE_TOKEN=

# Optional — set to "false" to show an "Applications Closed" message on the
# public page instead of the form. Defaults to open.
APPLICATIONS_OPEN=

# Optional — displays a deadline notice on the submission page, e.g.
# "31 July 2026". Purely cosmetic; nothing enforces it server-side.
CLOSING_DATE=

# Optional — venue and address shown under the form, e.g.
# "Secret Pour, Brooklyn NY". Linked to Google Maps. Leave unset and the
# details strip is hidden entirely.
SHOW_VENUE=

# Optional — shown beside the venue, e.g. "Doors 8pm".
SHOW_TIME=
